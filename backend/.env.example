# BaseCenter.ai Backend Configuration

# Security
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# Database
DATABASE_URL=postgresql://basecenter:basecenter123@localhost:5432/basecenter_db
POSTGRES_USER=basecenter
POSTGRES_PASSWORD=basecenter123
POSTGRES_DB=basecenter_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Admin
FIRST_SUPERUSER_EMAIL=admin@basecenter.ai
FIRST_SUPERUSER_PASSWORD=changeme123

# API
API_V1_PREFIX=/api/v1

# Settings encryption (Phase 1C) — REQUIRED in production.
# Used to encrypt Stripe secret keys at rest. Changing this after keys are
# saved makes previously stored secrets undecryptable.
SETTINGS_ENCRYPTION_KEY=change-me-to-a-stable-random-secret

# Frontend URL — used for Stripe Checkout success/cancel redirects.
FRONTEND_URL=http://localhost:3000
