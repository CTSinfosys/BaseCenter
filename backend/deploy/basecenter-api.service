[Unit]
Description=BaseCenter FastAPI backend (production)
After=network-online.target
Wants=network-online.target
# /home/ubuntu mounts late at boot (nofail) — never start before project files exist.
RequiresMountsFor=/home/ubuntu

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/github_repos/BaseCenter/backend
ExecStart=/opt/abacus-python/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
